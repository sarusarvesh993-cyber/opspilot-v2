"""
NSE Pre-Market Scanner - 8:45 AM IST - v2 with OpenRouter
Educational use only. NOT financial advice.
"""
import os
import pandas as pd
import yfinance as yf
import requests
from datetime import datetime
from dotenv import load_dotenv

load_dotenv()

# --- Keys ---
TELEGRAM_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
TELEGRAM_CHAT = os.getenv("TELEGRAM_CHAT_ID")
OPENROUTER_KEY = os.getenv("OPENROUTER_API_KEY")
OPENROUTER_MODEL = os.getenv("OPENROUTER_MODEL", "openai/gpt-4o-mini")

WATCHLIST_FILE = "watchlist.txt"

def load_watchlist():
    with open(WATCHLIST_FILE) as f:
        symbols = [s.strip().upper() for s in f if s.strip() and not s.strip().startswith("#")]
    return symbols

def get_quote_yf(symbol):
    try:
        t = yf.Ticker(symbol + ".NS")
        hist = t.history(period="10d", interval="1d", auto_adjust=False)
        if hist.empty or len(hist) < 2:
            return None
        prev_close = float(hist['Close'].iloc[-1])
        prev_prev = float(hist['Close'].iloc[-2])
        high_5d = float(hist['High'].tail(5).max())
        vol_avg = float(hist['Volume'].tail(5).mean())
        last_vol = float(hist['Volume'].iloc[-1])
        
        pct_1d = (prev_close - prev_prev) / prev_prev * 100
        near_breakout = prev_close / high_5d
        vol_spike = last_vol / vol_avg if vol_avg > 0 else 1.0

        return {
            "symbol": symbol,
            "prev_close": round(prev_close, 2),
            "pct_1d": round(pct_1d, 2),
            "near_breakout": round(near_breakout, 3),
            "vol_spike": round(vol_spike, 2),
        }
    except Exception:
        return None

def score_stock(q):
    score = 50.0
    score += max(-10, min(10, q["pct_1d"] * 3))
    if q["near_breakout"] > 0.99: score += 12
    elif q["near_breakout"] > 0.97: score += 6
    if q["vol_spike"] > 1.5: score += 8
    elif q["vol_spike"] > 1.2: score += 4
    return round(max(0, min(100, score)), 1)

def get_news_sentiment_openrouter(symbols):
    """Get overnight news bias via OpenRouter. Returns dict symbol -> +5/-5/0"""
    if not OPENROUTER_KEY:
        return {}
    symbol_list = ", ".join(symbols[:15])  # limit to keep it fast/cheap
    prompt = f"For Indian NSE stocks: {symbol_list}. Check overnight news for 26 July 2026 / last trading session. Return ONLY a JSON object like {{\"RELIANCE\": 0, \"TCS\": 5}} where 5 = strong positive news, -5 = strong negative, 0 = neutral. No explanation."
    
    try:
        r = requests.post("https://openrouter.ai/api/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {OPENROUTER_KEY}",
                "Content-Type": "application/json"
            },
            json={
                "model": OPENROUTER_MODEL,
                "messages": [{"role": "user", "content": prompt}],
                "temperature": 0.1,
                "max_tokens": 300
            }, timeout=20)
        text = r.json()["choices"][0]["message"]["content"]
        # extract json
        import json, re
        m = re.search(r'\{.*\}', text, re.DOTALL)
        if m:
            return json.loads(m.group(0))
    except Exception as e:
        print("News sentiment skipped:", e)
    return {}

def get_giftnifty_bias():
    try:
        t = yf.Ticker("^NSEI")
        hist = t.history(period="2d")
        if len(hist) >= 2:
            chg = (hist['Close'].iloc[-1] / hist['Close'].iloc[-2] -1)*100
            return chg
    except: pass
    return 0.0

def send_telegram(text):
    if not TELEGRAM_TOKEN or not TELEGRAM_CHAT:
        print("\n--- TELEGRAM NOT CONFIGURED ---\n", text)
        return
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    requests.post(url, json={"chat_id": TELEGRAM_CHAT, "text": text, "parse_mode": "Markdown"})

def main():
    symbols = load_watchlist()
    print(f"Scanning {len(symbols)} symbols...")
    
    market_bias = get_giftnifty_bias()
    results = []
    for sym in symbols:
        q = get_quote_yf(sym)
        if q:
            q["score"] = score_stock(q)
            results.append(q)
            print(f"  {sym}: {q['score']}")
    
    if not results:
        send_telegram("Scanner: No data. Check watchlist.")
        return

    # News sentiment via OpenRouter
    news_scores = get_news_sentiment_openrouter([r["symbol"] for r in results])
    for r in results:
        news = news_scores.get(r["symbol"], 0)
        r["news"] = news
        r["score"] = round(max(0, min(100, r["score"] + news)), 1)

    df = pd.DataFrame(results).sort_values("score", ascending=False)
    csv_name = f"scan_{datetime.now().strftime('%Y%m%d')}.csv"
    df.to_csv(csv_name, index=False)
    
    top5 = df.head(5)
    
    bias_emoji = "🟢" if market_bias > 0.2 else "🔴" if market_bias < -0.2 else "⚪"
    msg = f"*NSE Pre-Market 8:45 AM*\n{bias_emoji} Nifty bias: {market_bias:+.2f}%\n\n*Top 5 for Excel AI Verdict:*\n"
    for idx, (_, r) in enumerate(top5.iterrows(), 1):
        news_tag = "📰+" if r.get("news",0) > 0 else "📰-" if r.get("news",0) < 0 else ""
        msg += f"\n{idx}. *{r['symbol']}* {news_tag} | Score {r['score']}/100\n  ₹{r['prev_close']} | 1D {r['pct_1d']:+.2f}% | Vol {r['vol_spike']}x\n"

    msg += "\n_Next: Type these 5 into Excel Sheet1/Sheet2_\n_Take only: AI Verdict=Buy AND Auto-score >=7_\n_SL 0.5% | Target 1.0% | Not financial advice_"
    
    send_telegram(msg)
    print("\n" + msg)
    print(f"\nFull scan saved: {csv_name}")

if __name__ == "__main__":
    main()
